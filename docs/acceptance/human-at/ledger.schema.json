{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedron.readthedocs.io/en/latest/acceptance/human-at/ledger.schema.json",
  "title": "Hedron human AT redacted ledger row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "gate_ids",
    "combo_id",
    "os",
    "browser",
    "at",
    "task_id",
    "result",
    "owner",
    "retest_date",
    "redacted"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable opaque id for this ledger row (e.g. hat-0001)."
    },
    "gate_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "PROTOCOL-021",
          "SR-021",
          "PARTICIPANT-021",
          "ARTIFACT-021",
          "REMEDIATE-021"
        ]
      }
    },
    "combo_id": {
      "type": "string",
      "enum": [
        "vo-safari-macos",
        "nvda-firefox-windows",
        "talkback-chromium-android",
        "stretch-other"
      ]
    },
    "stretch": {
      "type": "boolean",
      "default": false,
      "description": "True for optional stretch AT outside the Verified minimum."
    },
    "session_id": {
      "type": "string",
      "description": "Opaque session id (sess-001); omit for maintainer-only SR passes without a compensated participant."
    },
    "participant_category": {
      "type": "string",
      "enum": ["screen_reader", "motor", "low_vision", "cognitive", "maintainer_sr"]
    },
    "os": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "browser": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "at": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "settings": { "type": "string" }
      }
    },
    "task_id": {
      "type": "string",
      "enum": [
        "login",
        "crud-form-pe",
        "crud-form-htmx",
        "fragment-refresh",
        "data-editor-smoke"
      ]
    },
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "login",
          "crud-form-pe",
          "crud-form-htmx",
          "fragment-refresh",
          "data-editor-smoke"
        ]
      },
      "description": "Optional consolidated task list when one row covers multiple tasks."
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "blocked", "incomplete", "placeholder"]
    },
    "severity": {
      "type": "string",
      "enum": ["blocker", "major", "minor", "note", "none"]
    },
    "known_issue": {
      "type": "string",
      "description": "Short redacted description of the issue or empty string when none."
    },
    "issue_url": {
      "type": "string",
      "description": "Public issue URL when filed."
    },
    "waiver_id": {
      "type": "string",
      "description": "Waiver id when shipping with an owned waiver."
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "retest_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "notes": {
      "type": "string",
      "description": "Redacted facilitator notes only."
    },
    "redacted": {
      "type": "boolean",
      "const": true,
      "description": "Must be true; affirms no participant PII in this row."
    }
  }
}
